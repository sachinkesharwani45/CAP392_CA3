class Solution {
    public void nextPermutation(int[] nums) {
        int n = nums.length;

        int idx=-1;
        for(int i= n-1;i>0;i--){
            if(nums[i]>nums[i-1]){
            idx=i-1;
            break;
            }
        }
        if(idx != -1){
            int swapidx=idx;
            for(int j=n-1;j>idx;j--){
                if(nums[j]>nums[idx]){
                    swapidx=j;
                    break;
                }
            }
            int temp=nums[idx];
            nums[idx]=nums[swapidx];
            nums[swapidx]=temp;
        }
        int left=idx+1;
        int right=n-1;
        while(left<right){
            int temp=nums[left];
            nums[left]=nums[right];
            nums[right]=temp;
            left++;
            right--;
        }
        
    
        
    }
}

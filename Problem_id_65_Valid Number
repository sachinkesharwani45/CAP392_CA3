class Solution {
    public boolean isNumber(String s) {

        boolean numSeen = false;
        boolean dotSeen = false;
        boolean expSeen = false;
        boolean numAfterExp = true;

        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            if (Character.isDigit(ch)) {
                numSeen = true;

                if (expSeen) {
                    numAfterExp = true;
                }
            }

            else if (ch == '.') {
                if (dotSeen || expSeen) {
                    return false;
                }
                dotSeen = true;
            }

            else if (ch == 'e' || ch == 'E') {
                if (expSeen || !numSeen) {
                    return false;
                }

                expSeen = true;
                numAfterExp = false;
            }

            else if (ch == '+' || ch == '-') {
                if (i != 0 && s.charAt(i - 1) != 'e'
                            && s.charAt(i - 1) != 'E') {
                    return false;
                }
            }

            else {
                return false;
            }
        }

        return numSeen && numAfterExp;
    }
}
